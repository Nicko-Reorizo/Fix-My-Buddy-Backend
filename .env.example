# Supabase PostgreSQL Session Pooler (port 5432)
DATABASE_URL="postgresql://postgres.zqvpolbcvglnhmdbgglk:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.zqvpolbcvglnhmdbgglk

# Server & Security Configuration
PORT=4000
MECHANIC_PRESENCE_MAX_AGE_S=120
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Vercel backend overrides: NODE_ENV=production
# Production frontend domain; exact origin is also allowed in src/utils/origins.js
# FRONTEND_ORIGIN=https://fixmybuddy.vercel.app
SESSION_SECRET=replace-with-a-random-64-char-hex-secret
PASSWORD_PEPPER=replace-with-a-secret-server-pepper

# Support contact info exposed at GET /support/config
SUPPORT_PHONE=+639170000111
SUPPORT_EMAIL=support@fixmybuddy.ph

# Optional Redis: leave blank for one local development server.
REDIS_URL=

# Distance Pricing & Platform Commission (5%)
PLATFORM_COMMISSION_RATE=0.05
PRICING_STEP_METERS=100
MECHANIC_RATE_PER_STEP_PHP=5
TOWING_RATE_PER_STEP_PHP=12
